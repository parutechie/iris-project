# ==========================================================
# IRIS Platform — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
# ==========================================================

# ----------------------------------------------------------
# PostgreSQL (matches docker-compose.yml settings)
# ----------------------------------------------------------

POSTGRES_DB=iris
POSTGRES_USER=iris_user
POSTGRES_PASSWORD=changeme

# Full SQLAlchemy connection URL — used by the application
# and Alembic. Port 5433 matches the docker-compose mapping.
DATABASE_URL=postgresql://iris_user:changeme@localhost:5433/iris

# ----------------------------------------------------------
# OpenAI (optional — only needed for the AI Advisor)
# ----------------------------------------------------------

OPENAI_API_KEY=sk-...
